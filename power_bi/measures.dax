// ====================================================================
// RefundShield AI - Enterprise DAX Measures Library
// Production-Ready DAX Formulas for Power BI Dashboard Implementation
// ====================================================================

// --------------------------------------------------------------------
// 1. Core Order & Financial Volume Measures
// --------------------------------------------------------------------

Total Orders = 
DISTINCTCOUNT(Fact_Orders[order_id])

Total Order Volume = 
SUM(Fact_Orders[order_amount])

Average Order Value (AOV) = 
DIVIDE([Total Order Volume], [Total Orders], 0)

Total Discounts = 
SUM(Fact_Orders[discount_amount])

Net Revenue = 
[Total Order Volume] - [Total Discounts]


// --------------------------------------------------------------------
// 2. Returns & Refunds Measures
// --------------------------------------------------------------------

Total Returns = 
DISTINCTCOUNT(Fact_Returns_Refunds[return_id])

Return Rate % = 
DIVIDE([Total Returns], [Total Orders], 0) * 100

Total Refund Amount = 
SUM(Fact_Returns_Refunds[refund_amount])

Refund Rate % = 
DIVIDE([Total Refund Amount], [Total Order Volume], 0) * 100

Average Refund Amount = 
DIVIDE([Total Refund Amount], [Total Returns], 0)

Pending Review Refunds = 
CALCULATE(
    [Total Refund Amount],
    Fact_Returns_Refunds[manual_review_flag] = 1
)

Pending Review Count = 
CALCULATE(
    COUNT(Fact_Returns_Refunds[refund_id]),
    Fact_Returns_Refunds[manual_review_flag] = 1
)


// --------------------------------------------------------------------
// 3. Fraud Detection & Risk Metrics
// --------------------------------------------------------------------

Fraudulent Returns Count = 
CALCULATE(
    COUNT(Fact_Orders[order_id]),
    Fact_Orders[fraud_label] = 1 && Fact_Orders[Has_Return] = 1
)

Fraud Loss Amount = 
CALCULATE(
    SUM(Fact_Orders[order_amount]),
    Fact_Orders[fraud_label] = 1
)

Fraud Rate % = 
DIVIDE([Fraudulent Returns Count], [Total Returns], 0) * 100

Average Risk Score = 
AVERAGE(Fact_Orders[risk_score])

High Risk Orders Count = 
CALCULATE(
    COUNT(Fact_Orders[order_id]),
    Fact_Orders[risk_score] >= 71
)

High Risk Orders % = 
DIVIDE([High Risk Orders Count], [Total Orders], 0) * 100

Medium Risk Orders Count = 
CALCULATE(
    COUNT(Fact_Orders[order_id]),
    Fact_Orders[risk_score] >= 31 && Fact_Orders[risk_score] < 71
)

Low Risk Orders Count = 
CALCULATE(
    COUNT(Fact_Orders[order_id]),
    Fact_Orders[risk_score] < 31
)

Amount Recovered / Intercepted = 
CALCULATE(
    SUM(Fact_Returns_Refunds[refund_amount]),
    Fact_Orders[risk_score] >= 71 && Fact_Returns_Refunds[refund_status] = "Pending"
)

Fraud Recovery Rate % = 
DIVIDE([Amount Recovered / Intercepted], [Fraud Loss Amount], 0) * 100


// --------------------------------------------------------------------
// 4. Customer Behavioral Risk Measures
// --------------------------------------------------------------------

Total Customers = 
DISTINCTCOUNT(Dim_Customer[customer_id])

High Risk Customers = 
CALCULATE(
    DISTINCTCOUNT(Fact_Orders[customer_id]),
    Fact_Orders[risk_score] >= 71
)

Serial Returners Count = 
CALCULATE(
    DISTINCTCOUNT(Fact_Orders[customer_id]),
    FILTER(
        VALUES(Fact_Orders[customer_id]),
        [Return Rate %] >= 65 && [Total Orders] >= 3
    )
)

Chargeback Incidents Count = 
CALCULATE(
    COUNT(Fact_Orders[payment_id]),
    Fact_Orders[chargeback_flag] = 1
)

Total Chargeback Losses = 
CALCULATE(
    SUM(Fact_Orders[chargeback_amount]),
    Fact_Orders[chargeback_flag] = 1
)


// --------------------------------------------------------------------
// 5. Physical Inspection & Delivery Partner Metrics
// --------------------------------------------------------------------

Empty Box Incidents = 
CALCULATE(
    COUNT(Fact_Returns_Refunds[return_id]),
    Fact_Returns_Refunds[Weight_Difference_Pct] >= 50
)

Item Mismatch Incidents = 
CALCULATE(
    COUNT(Fact_Returns_Refunds[return_id]),
    Fact_Returns_Refunds[item_match_flag] = 0
)

Tampered Packages Count = 
CALCULATE(
    COUNT(Fact_Orders[delivery_id]),
    Fact_Orders[package_tampered] = 1
)

Carrier Tampering Rate % = 
DIVIDE([Tampered Packages Count], [Total Orders], 0) * 100


// --------------------------------------------------------------------
// 6. Identity & Network Ring Measures
// --------------------------------------------------------------------

Unique Devices Count = 
DISTINCTCOUNT(Bridge_IdentityNetwork[device_id])

Average Accounts Per Device = 
DIVIDE(
    DISTINCTCOUNT(Bridge_IdentityNetwork[customer_id]),
    [Unique Devices Count],
    1
)

Multi-Account Sybil Devices = 
CALCULATE(
    DISTINCTCOUNT(Bridge_IdentityNetwork[device_id]),
    FILTER(
        VALUES(Bridge_IdentityNetwork[device_id]),
        CALCULATE(DISTINCTCOUNT(Bridge_IdentityNetwork[customer_id])) >= 2
    )
)
